<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Запрещаем облачное резервное копирование и Device-to-Device перенос
        на Android 12+: в данных приложения хранятся API-ключи и история чатов.
    -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
