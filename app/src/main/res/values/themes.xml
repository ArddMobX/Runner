<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Runner" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#121316</item>
        <item name="android:navigationBarColor">#121316</item>
        <item name="android:windowBackground">#121316</item>
    </style>

    <style name="Theme.Runner.Overlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
